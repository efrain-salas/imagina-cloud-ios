<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Imagina Cloud (IMAGINA.md): placeholder for the Firebase file Nextcloud's project copies into the app.
  Imagina Cloud sends no crash reports (disable_crash_service), so Firebase is never configured with it.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>not-used</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>build.imagina.cloud</string>
	<key>PROJECT_ID</key>
	<string>not-used</string>
	<key>STORAGE_BUCKET</key>
	<string>not-used</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<false/>
	<key>IS_SIGNIN_ENABLED</key>
	<false/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000</string>
</dict>
</plist>
